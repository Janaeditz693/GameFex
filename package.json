{
  "name": "gameflex-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install-all": "npm install --prefix backend && npm install --prefix client",
    "dev-backend": "npm run dev --prefix backend",
    "dev-client": "npm run dev --prefix client",
    "dev": "npx concurrently -k -p \"[{name}]\" -n \"Backend,Client\" -c \"cyan,magenta\" \"npm run dev-backend\" \"npm run dev-client\""
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
